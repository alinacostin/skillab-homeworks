# Copy to .env and fill in the keys for the provider(s) you want to use.

# Provider selection (ollama | gemini | anthropic)
DEFAULT_PROVIDER=gemini
# ⚠️ DEFAULT_MODEL e trimis VERBATIM provider-ului ales → trebuie să se potrivească
#    cu provider-ul. Nu lăsa un model Ollama (llama3.2) setat când alegi anthropic/gemini.
#    Lasă-l gol ca să folosească default-ul per-provider.
DEFAULT_MODEL=gemini-2.5-flash

# Ollama (local — no key, install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini — free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Storage (L4): pgvector via docker-compose.yml, port 5434 ---
DATABASE_URL=postgresql://skillab:skillab@localhost:5434/skillab_hw2

# --- Tema 4 · Memory, Caching & Intent ---

# Conversation memory (Part 1) — fereastra glisantă: câte mesaje recente încarcă.
MEMORY_WINDOW=10
# SESSION_ID (opțional): dacă e setat, `python agent.py` persistă conversația în Postgres
# (context între rulări). Lasă-l gol pentru un agent stateless (one-shot).
# SESSION_ID=andrei

# Prompt caching (Part 2) — DOAR pe Anthropic (cache_control: ephemeral).
# Auto-pornit când DEFAULT_PROVIDER=anthropic; forțează cu PROMPT_CACHE=1/0.
# Pentru a măsura caching-ul: DEFAULT_PROVIDER=anthropic (și DEFAULT_MODEL gol sau un model Claude).
# PROMPT_CACHE=1

# Intent classifier (Part 3) — prag de încredere sub care se face fallback la LLM.
# Cu calibrarea TF-IDF pe 3 clase, 0.5 ține sklearn pentru cazurile clare
# și cade pe LLM doar la ambiguitate reală.
CONFIDENCE_THRESHOLD=0.5
